    <!-- Permission onboarding -->
    <string name="onboarding_location_title">Location</string>
    <string name="onboarding_location_desc">Lokate needs your location to show you on the map to your family.</string>
    <string name="onboarding_background_location_title">Background location</string>
    <string name="onboarding_background_location_desc">To keep sharing your location even when the app isn\'t open, Android will ask you to choose \"Allow all the time\".</string>
    <string name="onboarding_activity_title">Smart battery saving</string>
    <string name="onboarding_activity_desc">With this permission the app notices the phone has been still for a while and stops asking for the location so often, without the group losing sight of you. It only reads the motion sensor: what you are doing is never stored. If you decline, the app still works, it just uses more battery.</string>
    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_desc">We\'ll notify you when someone in your family enters or leaves a saved zone.</string>
    <string name="onboarding_dnd_title">Ring even when silenced</string>
    <string name="onboarding_dnd_desc">To find this phone when it gets lost, the app needs permission to turn the alarm volume up and bypass Do Not Disturb. It only does this for “ring device” and emergency messages, and puts the volume back afterwards.</string>
    <string name="onboarding_battery_title">Ignore battery optimization</string>
    <string name="onboarding_battery_desc">Some systems close background apps to save battery. Without this permission, Lokate might stop sharing your location.</string>
    <string name="onboarding_manufacturer_title">Extra setting for your manufacturer</string>
    <string name="onboarding_manufacturer_desc">Your device (%1$s) is especially aggressive at closing background apps. Open the autostart/restrictions panel and let Lokate run freely.</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_open_settings">Open settings</string>
