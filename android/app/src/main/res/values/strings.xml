    <!-- Onboarding de permisos -->
    <string name="onboarding_location_title">Ubicación</string>
    <string name="onboarding_location_desc">Lokate necesita tu ubicación para mostrarte en el mapa a tu familia.</string>
    <string name="onboarding_background_location_title">Ubicación en segundo plano</string>
    <string name="onboarding_background_location_desc">Para seguir compartiendo tu ubicación aunque no tengas la app abierta, Android pedirá que elijas \"Permitir todo el tiempo\".</string>
    <string name="onboarding_activity_title">Ahorro de batería inteligente</string>
    <string name="onboarding_activity_desc">Con este permiso la app nota que el móvil lleva un rato quieto y deja de pedir la ubicación tan a menudo, sin que el grupo deje de verte. Solo se mira el sensor de movimiento: no se guarda qué estás haciendo. Si lo rechazas, la app funciona igual pero gasta más.</string>
    <string name="onboarding_notifications_title">Notificaciones</string>
    <string name="onboarding_notifications_desc">Te avisaremos cuando alguien de tu familia entre o salga de una zona guardada.</string>
    <string name="onboarding_dnd_title">Sonar aunque esté en silencio</string>
    <string name="onboarding_dnd_desc">Para poder encontrar este móvil cuando se pierda, la app necesita permiso para subir el volumen de la alarma y saltarse el modo No molestar. Solo lo usa al “hacer sonar” y con los mensajes de emergencia; el volumen se deja luego como estaba.</string>
    <string name="onboarding_battery_title">Ignorar optimización de batería</string>
    <string name="onboarding_battery_desc">Algunos sistemas cierran la app en segundo plano para ahorrar batería. Sin este permiso, Lokate podría dejar de compartir tu ubicación.</string>
    <string name="onboarding_manufacturer_title">Ajuste extra de tu fabricante</string>
    <string name="onboarding_manufacturer_desc">Tu dispositivo (%1$s) es especialmente agresivo cerrando apps en segundo plano. Abre el panel de autoarranque/restricciones y permite que Lokate se ejecute libremente.</string>
    <string name="onboarding_continue">Continuar</string>
    <string name="onboarding_open_settings">Abrir ajustes</string>
    <string name="onboarding_skip_warning">Sin este permiso, Lokate no funcionará correctamente</string>
    <string name="onboarding_skip_step">Continuar sin este permiso</string>
    <string name="onboarding_finish">Empezar a usar Lokate</string>

