    <string name="update_info_title">Cada cuánto se actualiza</string>
    <string name="update_info_last">Última actualización: hace %1$s (%2$s).</string>
    <string name="update_info_frequency">Ritmo elegido en su móvil: %1$s.</string>
    <string name="update_info_state">Ahora mismo: %1$s.</string>
    <string name="update_state_moving">En movimiento</string>
    <string name="update_state_still">Sin moverse</string>
    <string name="update_state_home_wifi">En una de sus wifis de casa</string>
    <string name="update_state_live">En tiempo real</string>
    <string name="update_state_on_demand">Solo contesta si se lo piden</string>
    <string name="update_state_unknown">Desconocido</string>
    <string name="update_body_moving">Mientras se mueve, su móvil manda la posición al ritmo que tiene elegido. Puede llegar hasta un minuto más tarde: el sistema junta varias posiciones y las entrega de una vez, para no encender la radio a cada rato.</string>
    <string name="update_body_still">Su móvil ha visto que lleva un rato sin moverse (por el sensor de actividad física, o porque su posición no cambia) y ha espaciado las actualizaciones a una cada 15 minutos, tenga el ritmo que tenga elegido. Además, estando parado solo manda posición si se desplaza más de 100 metros, para no dibujar paseos que no existen. En cuanto vuelva a moverse recupera su ritmo al instante.</string>
    <string name="update_body_home_wifi">Está conectado a una wifi que tiene marcada como sitio fijo (casa, trabajo, casa de los abuelos). Mientras siga ahí, su móvil actualiza una vez cada 15 minutos en lugar de a su ritmo: si no se está moviendo, preguntar cada minuto solo gasta batería. Al salir de esa wifi vuelve a su ritmo.</string>
    <string name="update_body_live">Alguien lo tiene en seguimiento en tiempo real: su móvil manda posición cada pocos segundos mientras dure, por encima del ritmo que tenga elegido.</string>
    <string name="update_body_on_demand">Su móvil no manda posición por su cuenta. Solo responde cuando alguien pulsa el botón de actualizar en su ficha, así que la hora que ves es la de la última vez que se la pidieron.</string>
    <string name="update_body_unknown">Su app es anterior a esta versión y todavía no manda este dato, así que no se puede saber por qué tarda.</string>
    <string name="update_info_overdue">Lleva bastante más de lo esperable sin dar señales. Lo habitual es que sea falta de cobertura (un envío que falla no se reintenta: se espera al siguiente), el ahorro de energía del móvil con la batería baja, o que el sistema haya detenido su app.</string>
    <string name="update_info_footer">La hora que se muestra es la de la última posición que llegó al servidor, no la de la última vez que su móvil miró dónde estaba.</string>
    <string name="frequency_short_high">en tiempo real</string>
    <string name="frequency_short_30_sec">cada 30 s</string>
    <string name="frequency_short_1_min">cada minuto</string>
    <string name="frequency_short_balanced">cada 2 min</string>
    <string name="frequency_short_5_min">cada 5 min</string>
    <string name="frequency_short_battery_saver">cada 10 min</string>
    <string name="frequency_short_unknown">frecuencia desconocida</string>
    <!-- Lo que se enseña en lugar de su frecuencia mientras alguien lo sigue en vivo: su móvil
