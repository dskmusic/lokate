# Genera un valor aleatorio largo, por ejemplo con: openssl rand -hex 32
JWT_SECRET=changeme

# Credenciales del panel de administración (https://tu-dominio/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Usuario admin maestro de la APP (no del panel /admin) — se crea solo al arrancar si no existe.
# Con él puedes entrar en la app, crear el primer grupo familiar y asignar más admins desde /admin.
MASTER_ADMIN_USERNAME=dskmusic
MASTER_ADMIN_PASSWORD=orionM45@

# Días de validez del token de sesion
ACCESS_TOKEN_EXPIRE_DAYS=30

# Días que se conserva el historial de ubicaciones por usuario
LOCATION_RETENTION_DAYS=30

# Ruta DENTRO del contenedor al JSON de credenciales de Firebase Admin SDK
# (se monta como volumen en docker-compose.yml desde ./firebase-credentials.json)
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# No tocar salvo que cambies a Postgres
DATABASE_URL=sqlite:////data/lokate.db
